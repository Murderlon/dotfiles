# DroidCam Classic over iPhone USB
DROIDCAM_UDID=YOUR_IPHONE_UDID
DROIDCAM_PORT=4747
DROIDCAM_DEVICE=/dev/droidcam-video
DROIDCAM_SIZE=1920x1080
DROIDCAM_CONNECT_TIMEOUT=15
DROIDCAM_STALE_TIMEOUT=8
DROIDCAM_MAX_BACKOFF=10
DROIDCAM_POLL_INTERVAL=2
# Keep the camera node stable briefly while reconnecting an interrupted stream.
DROIDCAM_FORMAT_GRACE=15
