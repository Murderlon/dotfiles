# See https://git-scm.com/docs/git-config

[user]
	name = Murderlon
	email = merlijn@soverin.net
	signingkey = ~/.ssh/github_signing

[gpg]
	format = ssh

[gpg "ssh"]
	program = /usr/bin/ssh-keygen

[alias]
	# Show most recently worked on branches
	recent = "!git for-each-ref --count=10 --sort=-committerdate refs/heads/ --format='%(refname:short)' | fzf | xargs git checkout"
	# Create a fixup commit linked to another commit
	fixup = "!git log -n 20 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"
	# Show commits since the last tag
	unreleased = "!git log --pretty=oneline --graph --abbrev-commit $(git describe --tags --abbrev=0 @^)..@"
	# Delete local branches whose remote branch is gone (or which have no upstream)
	cleanbranches = "!f(){ git fetch -p && cur=$(git branch --show-current); git for-each-ref --format '%(refname:short) %(upstream) %(upstream:track)' refs/heads | while read branch up track; do [ \"$branch\" != \"$cur\" ] && { [ -z \"$up\" ] || [ \"$track\" = \"[gone]\" ]; } && git branch -D \"$branch\"; done; }; f"

[apply]
	# Detect whitespace errors when applying a patch
	whitespace = fix

[core]
	editor = nvim
	autocrlf = input
	preloadIndex = true
	ignoreCase = false

[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false

[blame]
	coloring = highlightRecent
	date = relative

[status]
	branch = true
	short = true
	showStash = true
	showUntrackedFiles = all

[commit]
	gpgsign = true
	verbose = true

[difftool]
	# Run the difftool immediately, don't ask for confirmation each time.
	prompt = false

[pager]
	difftool = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[column]
	ui = auto

[merge]
	log = true
	conflictStyle = diff3

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[init]
	defaultBranch = main

[rerere]
	enabled = true
	autoupdate = true

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[rebase]
	updateRefs = true
	autoSquash = true

[log]
	abbrevCommit = true
	graphColors = blue,yellow,cyan,magenta,green,red
	decorate = short
	date = relative
	mailmap = true

[format]
	pretty = %C(auto)%h %C(blue)%d%C(reset) %s %C(green)(%cr)%C(reset)

[color "blame"]
	highlightRecent = black bold,1 year ago,white,1 month ago,default,7 days ago,blue

[color "branch"]
	current = magenta
	local = default
	remote = yellow
	upstream = green
	plain = blue

[color "status"]
	added = green
	changed = yellow
	untracked = blue
	unmerged = red

[color.decorate]
	HEAD = red
	branch = blue
	tag = yellow
	remoteBranch = magenta
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
